{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fleek",
  "workers_dev": true,
  "compatibility_date": "2026-10-01",
  "main": "freebuff-sites-build/worker.js",
  "assets": {
    "directory": "freebuff-sites-build/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fleek",
      "database_id": "a4e9c801-6384-4432-a5d2-ec0b1733310c"
    }
  ],
  "vars": {
    "FREEBUFF_CLIENT_ID": "d420fdd9-4b07-4f47-ac66-3caf5f1e3fc4",
    "FREEBUFF_ISSUER": "https://freebuff.com/oidc",
    "APP_ORIGIN": "http://localhost:8787"
  }
}
